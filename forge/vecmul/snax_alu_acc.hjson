// Written by hand in LNK2a round 1; snax-forge's writer replaces it in round 2.
// The accelerator of design vecmul (out/design/vecmul/design_point.json in
// snax-forge): instance acc, BRM elementwise_mul, implementation chisel_tiled_spatial,
// block ElementwiseTiledSpatial, in snax_alu.hjson's slot (snax_acc_name snax_alu).
// From GEN3's forge_vecmul_acc.py: the streamer template (readers the input
// ports in the BRM's port order, writers the output ports) and the datapath
// block SNAX-GVSoC's standard composite takes (snax/snax_cfg.py,
// snax/snax_unit_acc.py).
{
    snax_streamer_cfg: {
        data_reader_params: {
            spatial_bounds: [[4], [4]],
            temporal_dim: [1, 1],
            num_channel: [4, 4],
            fifo_depth: [8, 8],
        },
        data_writer_params: {
            spatial_bounds: [[4]],
            temporal_dim: [1],
            num_channel: [4],
            fifo_depth: [8],
        },
    },

    datapath: {
        unit: "SnaxUnit",
        inputs: ["a", "b"],
        outputs: ["out"],
        lanes: 4,
        data_width: 64,
        op: 2,
        signed: true,
        control: "counted",
        wait: "lockstep",
        latency: 0,
        ii: 1,
        fields: ["loopCount"],
    },
}
